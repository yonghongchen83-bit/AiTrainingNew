{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "windows": "python scripts/validate_milestone_commit.py --event SessionStart",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "windows": "python scripts/validate_milestone_commit.py --event PreToolUse",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "windows": "python scripts/validate_milestone_commit.py --event PostToolUse",
        "timeout": 15
      }
    ]
  }
}
