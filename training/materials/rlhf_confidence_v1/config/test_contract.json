{
  "test_id": "rlhf_confidence",
  "test_type": "evaluation",
  "version": "1.0",
  "controller": {
    "module": "training/materials/rlhf_confidence_v1/simulation/simulator.py",
    "entry": "simulate_batch"
  },
  "generic": {
    "step_size": 1,
    "batch_size": 8,
